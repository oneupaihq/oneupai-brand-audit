# Copy to .env.local for local development. In Vercel, set these under Project Settings > Environment Variables.

# Postgres. Vercel's Neon integration sets this for you. Locally you can use an in-process database:
DATABASE_URL=pglite:./.data/pg

# Data sources. Leave blank to run in sample mode (every audit is marked as sample data).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# standard = cheaper task queue (default); live = faster, about 3x the SERP price
DATAFORSEO_MODE=standard
# One Google Cloud key with PageSpeed Insights API, Places API (New) and YouTube Data API v3 enabled
GOOGLE_API_KEY=

# Wording, content review and strategy brief. Optional: without it, the rule-written text is used.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Sign-in password for the tool, and the secret for the cron and job endpoints
APP_PASSWORD=
CRON_SECRET=

# Where report links point
REPORT_BASE_URL=https://audit.oneupai.com

# Optional: pin the assistant models asked through DataForSEO (otherwise the newest web-search model is picked)
LLM_MODEL_CHATGPT=
LLM_MODEL_CLAUDE=
LLM_MODEL_GEMINI=
